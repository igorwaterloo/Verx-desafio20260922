{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Autenticacao": {
    "Audiencia": "fluxo-caixa-api"
  },
  "Gateway": {
    "TamanhoMaximoDoCorpoBytes": 1048576
  },
  "LimitesDeRequisicao": {
    "RequisicoesPorSegundo": {
      "free": 20,
      "pro": 100
    },
    "OnboardingPorMinutoPorIp": 10,
    "PublicoPorMinutoPorIp": 120
  },
  "Cors": {
    "OrigensPermitidas": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "onboarding": {
        "ClusterId": "tenants",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "onboarding",
        "Match": { "Path": "/api/v1/tenants", "Methods": [ "POST" ] }
      },
      "tenants": {
        "ClusterId": "tenants",
        "Order": 2,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "por-tenant",
        "Match": { "Path": "/api/v1/tenants/{**resto}" }
      },
      "planos": {
        "ClusterId": "tenants",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "publico",
        "Match": { "Path": "/api/v1/planos/{**resto}", "Methods": [ "GET" ] }
      },
      "lancamentos": {
        "ClusterId": "lancamentos",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "por-tenant",
        "Match": { "Path": "/api/v1/lancamentos/{**resto}" }
      },
      "consolidado": {
        "ClusterId": "consolidado",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "por-tenant",
        "Match": { "Path": "/api/v1/consolidado/{**resto}", "Methods": [ "GET" ] }
      }
    },
    "Clusters": {
      "tenants": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "tenants-api": { "Address": "http://tenants-api:8080" }
        }
      },
      "lancamentos": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": {
          "lancamentos-api": { "Address": "http://lancamentos-api:8080" }
        }
      },
      "consolidado": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:15"
          }
        },
        "Destinations": {
          "consolidado-api-1": { "Address": "http://consolidado-api-1:8080" },
          "consolidado-api-2": { "Address": "http://consolidado-api-2:8080" }
        }
      }
    }
  }
}
