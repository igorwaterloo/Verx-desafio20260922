# Copie para deploy/.env e ajuste os valores. O arquivo .env NÃO é versionado.
# Valores abaixo servem apenas para desenvolvimento local.

# SQL Server (mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo)
MSSQL_SA_PASSWORD=FluxoCaixa@Local123

# RabbitMQ
RABBITMQ_USER=fluxocaixa
RABBITMQ_PASSWORD=FluxoCaixa@Local123

# Keycloak — administrador do console (http://localhost:8081)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=FluxoCaixa@Local123

# Segredo da conta de serviço do Tenants.Api no Keycloak (client fluxo-caixa-tenants)
TENANTS_CLIENT_SECRET=troque-este-segredo-local
